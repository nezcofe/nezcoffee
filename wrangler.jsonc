{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nezcoffee",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e6b94b69-493c-4aa6-9704-b96765f07f60","database_name": "nezcoffee" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e3d592559e964b83a7bd3be2dacfeb81" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
